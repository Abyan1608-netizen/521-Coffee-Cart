<?xml version="1.0" encoding="utf-8"?>
<!-- Hanya HTTPS, hanya sertifikat sistem (sertifikat buatan pengguna tidak dipercaya). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
