+                else if (mime.contains("wav") || low.endsWith(".wav")) ext = "wav";
+                else if (mime.contains("aac") || low.endsWith(".aac")) ext = "aac";
+                else if (mime.contains("mp4") || mime.contains("m4a") || low.endsWith(".m4a")) ext = "m4a";
