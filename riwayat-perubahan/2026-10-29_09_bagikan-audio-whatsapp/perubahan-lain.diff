+    /** Audio dibagikan dari aplikasi lain (WhatsApp, Rekaman Suara, dll) → impor sebagai suara notifikasi. */
+    @SuppressWarnings("deprecation")
+    private void handleShare(Intent in) {
+        if (in == null || !Intent.ACTION_SEND.equals(in.getAction())) return;
+        String t = String.valueOf(in.getType());
+        if (!t.startsWith("audio/") && !t.equals("application/ogg")) return;
+        Uri u = Build.VERSION.SDK_INT >= 33 ? in.getParcelableExtra(Intent.EXTRA_STREAM, Uri.class) : (Uri) in.getParcelableExtra(Intent.EXTRA_STREAM);
+        in.setAction(Intent.ACTION_MAIN); // jangan diproses dua kali saat layar diputar
+        if (u == null) return;
+        importSound(u, json -> main.post(() -> { if (pageReady) deliverSoundIn(json); else pendingSoundIn = json; }), 0);
+    }
+
+    private void deliverSoundIn(String json) {
+        web.evaluateJavascript("window.__a521soundIn&&window.__a521soundIn(" + JSONObject.quote(json) + ")", null);
+    }
